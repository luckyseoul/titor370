*        Character handling: copy, search, translate.
*        TRT finds the first byte carrying a non-zero tag, leaving its address
*        in R2 and the tag in R1. TR maps lower case to upper case.
*        The translate table is the identity except for the three non-contiguous
*        EBCDIC lower-case runs (a-i, j-r, s-z); anything not mapped must still
*        translate to itself.
         ORG   0x1000
START    BALR  12,0
         USING *,12
         MVC   COPY(11),SRC       ; copy 11 characters, left to right
         TRT   COPY(11),SETTAB    ; find the first tagged byte
         TR    COPY(11),TABLE     ; lower case -> upper case
         DIAG  0,0,0
SRC      DC    C'hello world'
COPY     DS    11C
*        256-byte identity translate table with three overrides
TABLE
         DC    X'000102030405060708090A0B0C0D0E0F'
         DC    X'101112131415161718191A1B1C1D1E1F'
         DC    X'202122232425262728292A2B2C2D2E2F'
         DC    X'303132333435363738393A3B3C3D3E3F'
         DC    X'404142434445464748494A4B4C4D4E4F'
         DC    X'505152535455565758595A5B5C5D5E5F'
         DC    X'606162636465666768696A6B6C6D6E6F'
         DC    X'707172737475767778797A7B7C7D7E7F'
         DC    X'80'
         DC    X'C1C2C3C4C5C6C7C8C9'
         DC    X'8A8B8C8D8E8F'
         DC    X'90'
         DC    X'D1D2D3D4D5D6D7D8D9'
         DC    X'9A9B9C9D9E9F'
         DC    X'A0A1'
         DC    X'E2E3E4E5E6E7E8E9'
         DC    X'AAABACADAEAF'
         DC    X'B0B1B2B3B4B5B6B7B8B9BABBBCBDBEBF'
         DC    X'C0C1C2C3C4C5C6C7C8C9CACBCCCDCECF'
         DC    X'D0D1D2D3D4D5D6D7D8D9DADBDCDDDEDF'
         DC    X'E0E1E2E3E4E5E6E7E8E9EAEBECEDEEEF'
         DC    X'F0F1F2F3F4F5F6F7F8F9FAFBFCFDFEFF'
*        Tag table: byte 0x96 (EBCDIC lower-case 'o') carries tag 0x01
SETTAB   DC    150X'00'
         DC    X'01'
         DC    105X'00'
         END   START
