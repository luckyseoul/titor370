         ORG   0x1000
START    BALR  12,0
         USING *,12
         L     1,VAL
         SLL   1,32
         ST    1,OUT1
         L     2,VAL
         SRL   2,40
         ST    2,OUT2
         L     3,NEG
         SRA   3,33
         ST    3,OUT3
         DIAG  0,0,0
VAL      DC    F'1'
NEG      DC    F'-8'
OUT1     DS    F
OUT2     DS    F
OUT3     DS    F
         END   START
